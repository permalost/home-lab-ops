# Binds to service.yaml via the kubernetes.io/service-name label — that's
# the only link, the EndpointSlice's own name doesn't matter.
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: __NAME__
  labels:
    kubernetes.io/service-name: __NAME__
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: __PORT__
endpoints:
  - addresses:
      - __ADDRESS__
